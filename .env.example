# Application
APP_NAME=coffee_house
APP_ENV=local
APP_DEBUG=true

# Authentication
# Generate local values, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

ADMIN_REGISTRATION_CODE=replace-with-a-long-random-admin-code


POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=coffee_house
POSTGRES_USER=coffee_house
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+asyncpg://coffee_house:replace-with-a-database-password@db:5432/coffee_house


REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=coffee_house


AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
CATALOG_CACHE_TTL_SECONDS=60


KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_CLIENT_ID=coffee-house
KAFKA_LAB_CONSUMER_GROUP=coffee-house.kafka-lab
KAFKA_NOTIFICATIONS_CONSUMER_GROUP=coffee-house.notifications

KAFKA_CUSTOMER_REQUEST_EVENTS_TOPIC=coffee.customer-request-events.v1
KAFKA_CUSTOMER_REQUEST_EVENTS_DLQ_TOPIC=coffee.customer-request-events.dlq.v1
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_DELAY_SECONDS=1.0


OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=1.0


TELEGRAM_BOT_TOKEN=
TELEGRAM_API_TIMEOUT_SECONDS=10.0
